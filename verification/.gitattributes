# Everything in here is executed on Linux -- inside the container, on the CHTC
# access point, or on an execute node -- so these files must keep LF endings
# even when checked out on Windows with core.autocrlf=true.
#
# Without this, a Windows checkout gives run_verify.sh CRLF endings and bash in
# the container fails with:
#     run_verify.sh: line 19: $'\r': command not found
#     run_verify.sh: line 65: syntax error near unexpected token `$'in\r''
# which is fatal in a real HTCondor job, not just locally.
#
# HTCondor also parses .sub files line by line; a trailing \r would ride along
# into macro values such as arguments and container_image.

*.sh    text eol=lf
*.sub   text eol=lf
*.py    text eol=lf
Makefile text eol=lf
.env.example text eol=lf
