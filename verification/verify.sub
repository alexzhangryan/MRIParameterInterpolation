# verify.sub: HTCondor submit file for E2E VarNet evaluation on CHTC.
# Deliberately the same shape as ../training/train.sub: the same macros, the
# same guards, the same model presets applied by submit.sh, the same logs/ and
# runs/<model>/<Cluster>/ layout, the same resources. The only thing that
# differs is what runs inside the job: verify_varnet.py scores a checkpoint
# on multicoil_val instead of training one from scratch.
# Submit from this directory via ./submit.sh (or `make submit-model1`), which
# creates the log/run directories, applies the per-model macros, checks that
# the W&B key is exported, and proves with -dry-run that the preset reached
# the job ad.
#
#   ./submit.sh model2 ckpt=../training/runs/brain/model2/123/checkpoints/last.ckpt run_name=verify-model2-brain
#                                          the trained baseline at 2x/4x/6x/8x plus the mixed pass, brain val batch 0
#   ./submit.sh model2 ckpt=../dpi/runs/brain/dpi/456/checkpoints/last.ckpt run_name=verify-dpi-brain
#                                          the same for a DPI checkpoint (the harness detects it)
#   ./submit.sh model1                     4x only, released knee weights (a knee model on brain data: a sanity row)
#   ./submit.sh tier1                      the Claim A sweep: random masks 4x/8x, knee full 199-volume val
#   ./submit.sh model2 volume_limit=5 extra_args="--num_workers 0" ckpt=...
#   ./submit.sh model2 dataset=knee staging=/staging/a/apryan3/fastmri val_data=file:///staging/a/apryan3/fastmri/knee_multicoil_val_subset.tar request_disk=60GB
#                                          the 2026-09 knee subset, for the record
#
# `dataset` / `staging` default to the fastMRI brain set in the group
# directory, as train.sub does since 2026-09-18. The knee material in this
# account's personal staging (`knee_staging`) is only used for the released
# knee checkpoint that `ckpt` defaults to and for the knee presets above.

# --- how the defaults in this file work --------------------------------------
# Every macro below is a DEFAULT ONLY and is wrapped in `if ! defined`. That
# guard is load-bearing, not style.
#
# condor_submit parses a command-line `name=value` "as if it was placed at the
# beginning of the submit description file" (condor_submit man page). A plain
# `model = model1` line here is therefore parsed AFTER it and silently
# overwrites it. That bug shipped on the training side and cost a run: on
# 2026-09-13 `make submit-model2` trained model 1's schedule for three hours
# and logged into the varnet-model1 W&B run (see train.sub). So: any knob
# meant to be overridable from the command line gets the guard, and submit.sh
# re-checks the resolved job ad with -dry-run before it submits.
if ! defined dataset
  dataset = brain
endif
if ! defined staging
  staging = /staging/groups/kamilov_group/Kamilov-SciAI-datasets/fastMRI_brain
endif
if ! defined knee_staging
  knee_staging = /staging/a/apryan3/fastmri
endif
# 2026-09-18 tag: wandb 0.26.1, which accepts W&B's current 86-character API
# keys (the 2026-09 tag's wandb 0.18.7 does not). Build and push with
#   make build push IMAGE=genjigod/fastmri-verify:2026-09-18
if ! defined image
  image = docker://genjigod/fastmri-verify:2026-09-18
endif

# --- what to evaluate --------------------------------------------------------
# The two lists are paired elementwise (fastmri.data.subsample.MaskFunc) and
# are the same presets training uses. Training draws one pair per sample;
# evaluation scores every pair over the whole val set, one pass per rate.
# Defaults are model 1; submit.sh overrides them for model 2. center_fractions
# follow the fastMRI convention 0.32 / R (0.08 at 4x, 0.04 at 8x).
if ! defined model
  model = model1
endif
if ! defined accelerations
  accelerations = 4
endif
if ! defined center_fractions
  center_fractions = 0.08
endif
if ! defined mask_type
  mask_type = equispaced_fraction
endif
if ! defined volume_limit
  volume_limit = 0
endif
# run_name is the W&B run NAME and the W&B run ID and the run_id in
# results.csv. Two evaluations that share it become one run in W&B; a
# resubmission of the same evaluation must keep it. Deriving it from $(model)
# is what keeps the runs apart, so it is only correct as long as $(model) is.
# Pass run_name=verify-model1-trained (with ckpt=) for a genuinely new run.
if ! defined run_name
  run_name = verify-$(model)
endif
if ! defined extra_args
  extra_args =
endif
arguments        = tier1 --run_name $(run_name) --accelerations $(accelerations) --center_fractions $(center_fractions) --mask_type $(mask_type) --volume_limit $(volume_limit) $(extra_args)

# --- container ---------------------------------------------------------------
universe        = container
container_image = $(image)
executable      = run_verify.sh

# --- input files -------------------------------------------------------------
# Large inputs live in /staging and are transferred into the job scratch by
# HTCondor, never read directly (and never extracted there: the group
# directory has a 10,000-item cap). The default is NYU's
# brain_multicoil_val_batch_0.tar.xz (460 volumes, ~100 GB compressed), the
# same file train.sub validates against, so every checkpoint is scored on the
# volumes it was validated on. The knee subset of 2026-09 is the
# dataset=knee example at the top. CHTC's size rule: osdf:///chtc/staging/<path>
# for 1-30 GB inputs, file:///staging/<path> from 30 GB up; file:// works for both.
#
# `ckpt` is the checkpoint to score: the released fastMRI knee model by
# default, or a Lightning checkpoint from ../training
# (ckpt=../training/runs/brain/model2/<Cluster>/checkpoints/last.ckpt) or
# from ../dpi (ckpt=../dpi/runs/brain/dpi/<Cluster>/checkpoints/last.ckpt).
# run_verify.sh picks up whatever *.pt / *.ckpt lands in the sandbox, and
# verify_varnet.py reads the architecture (cascades, channels, pools, and
# for a DPI checkpoint its lambda settings) from the file itself.
# ../dpi/dpi_varnet.py travels with the harness (HTCondor drops it flat in
# the sandbox by basename) so a DPI checkpoint can be rebuilt there.
if ! defined val_data
  val_data = file://$(staging)/$(dataset)_multicoil_val_batch_0.tar.xz
endif
if ! defined ckpt
  ckpt = file://$(knee_staging)/knee_leaderboard_state_dict.pt
endif
transfer_input_files = verify_varnet.py, ../dpi/dpi_varnet.py, $(val_data), $(ckpt)
should_transfer_files    = YES
# ON_EXIT_OR_EVICT: output/ (partial results, the W&B run) comes back even
# when the job is evicted, the same as train.sub.
when_to_transfer_output  = ON_EXIT_OR_EVICT

# --- output files ------------------------------------------------------------
# output/tier1_report.json, output/per_volume_R<N>.csv, output/results.csv,
# output/wandb/ (offline run if no key)
transfer_output_files   = output
transfer_output_remaps  = "output = runs/$(dataset)/$(model)/$(Cluster)"

# --- secrets -----------------------------------------------------------------
# Only these names are copied from the submitting shell, and only if set. The
# key never appears in this file or in any committed file. It does appear in
# the job ClassAd (condor_q -l), readable by you and CHTC admins only.
getenv          = WANDB_API_KEY, WANDB_ENTITY, WANDB_PROJECT
environment     = "WANDB_PROJECT=fastmri-varnet-verify"

# --- resources ---------------------------------------------------------------
# Same slot class as train.sub. request_disk covers peak scratch during
# extraction: run_verify.sh deletes a tarball only after `xz | tar` finishes,
# so compressed + extracted coexist. A ~100 GB NYU .xz batch extracts to
# roughly twice that (the knee full split: 93.8 GB + ~192 GB), hence 320 GB
# for brain val batch 0 as for the knee tier1 preset. The 20 GB knee subset
# is a plain .tar and is fine with request_disk=60GB. Size it from the
# tarball actually staged (du -sh on /staging) and override on the command line.
#
# HasCHTCStaging selects slots that can read /staging inputs. bad_nodes is the
# escape hatch for an execute node whose GPU stack is broken in a way that is
# not our problem to fix (train.sub: gpu4003, 2026-09-12). Override for one
# submission:  ./submit.sh model1 bad_nodes='"gpu4003.chtc.wisc.edu"'
if ! defined bad_nodes
  bad_nodes = "gpu4003.chtc.wisc.edu"
endif
requirements    = (Target.HasCHTCStaging == true) && !stringListMember(Target.Machine, $(bad_nodes))
# request_cpus and request_memory are the two exceptions to the `if ! defined`
# rule: condor_submit seeds them into the macro table BEFORE reading this file
# (they carry HTCondor's own defaults), so the guard never fires and the request
# silently collapses to 1 CPU and an ImageSize-derived memory figure. Hence the
# aliases. Override these two as cpus=16 / mem=64GB, not as request_cpus= /
# request_memory=, which this file would overwrite. submit.sh prints all four
# from the dry-run ad before submitting.
#
# cpus: DataLoader workers (--num_workers, default 4) plus the main process.
if ! defined cpus
  cpus = 8
endif
if ! defined mem
  mem = 48GB
endif
request_cpus    = $(cpus)
request_memory  = $(mem)
if ! defined request_disk
  request_disk = 320GB
endif
if ! defined request_gpus
  request_gpus = 1
endif
gpus_minimum_memory     = 24000M
gpus_minimum_capability = 7.0
# Upper bound matters: this image's PyTorch ships kernels for sm_37..sm_90.
# An sm_120 (Blackwell) slot matches happily and then dies with "no kernel
# image is available for execution on the device" at the first kernel launch.
gpus_maximum_capability = 9.0
+WantGPULab     = true
# Inference only. Brain val batch 0 through model2's five passes (R2, R4, R6,
# R8, mixed) is about 2.5-4 h of inference after ~1-2 h of transfer and
# extraction, inside the 12 h "short" class, which queues faster than
# training's "long".
if ! defined gpu_job_length
  gpu_job_length = "short"
endif
+GPUJobLength   = $(gpu_job_length)

# --- transient node failures -------------------------------------------------
# Hold codes 6 (execute-node problem before anything ran: docker daemon,
# NVIDIA container hook) and 13 (input transfer failed, e.g. a stalled
# /staging read) mean "the node, not this run" and are released automatically
# a few times; see train.sub for the two incidents behind this. A repeatable
# failure (a missing staging file also holds with 13) still surfaces as a
# hold after five tries instead of looping.
max_retries     = 5
periodic_release = (HoldReasonCode == 6 || HoldReasonCode == 13) && (NumSystemHolds < 5) && ((time() - EnteredCurrentStatus) > 300)

# --- logs ------------------------------------------------------------------
log             = logs/$(dataset)_$(model)_$(Cluster).log
output          = logs/$(dataset)_$(model)_$(Cluster)_$(Process).out
error           = logs/$(dataset)_$(model)_$(Cluster)_$(Process).err
stream_output   = True
stream_error    = True

queue 1
