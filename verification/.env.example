# .env.example -- template for the verification harness's secrets.
#
#   cp .env.example .env      then paste your values into .env
#
# .env is gitignored; .env.example (this file, no real values) is committed.
# Load it before running submit.sh or prepare_staging.sh:
#
#     set -a; source .env; set +a
#
# Values are quoted on purpose. The NYU presigned URLs contain & and ?, which
# an unquoted shell assignment would treat as operators. Keep the quotes.
#
# NOTHING HERE IS NEEDED FOR `make local-run`. Every local target passes
# --no_wandb and uses synthetic data, so the full local smoke test runs with
# an empty .env or no .env at all.


# --- Weights & Biases -------------------------------------------------------
# Get it from: https://wandb.ai/authorize
#
# Needed for : CHTC runs. submit.sh refuses to submit without it unless you
#              pass OFFLINE=1, in which case W&B logs offline into results/wandb
#              and you `wandb sync runs/<Cluster>/wandb/offline-run-*` later.
# Not needed : any local target.
#
# SECURITY (CLAUDE.md / ROADMAP.md): a W&B key from a prior project is sitting
# in public git history in Research/inpainting.sub. Rotate that key before you
# use any key here, and never paste a key into a .sub file -- verify.sub picks
# it up from your shell via HTCondor `getenv`, which is why it stays out of the
# repo.
WANDB_API_KEY=''

# Optional. Your W&B username or team name. Blank = your default entity.
WANDB_ENTITY=''

# Optional. The harness defaults to this if unset.
WANDB_PROJECT='fastmri-varnet-verify'


# --- fastMRI knee dataset (NYU) ---------------------------------------------
# Get them from: the approval email after applying at
#                https://fastmri.med.nyu.edu/  (accept the KNEE agreement)
#
# These are presigned S3 URLs that embed AWSAccessKeyId and Signature, so they
# ARE credentials, not just links. They expire roughly 90 days after issue.
# Paste them exactly as they appear in the email, including the query string.
#
# Needed for : prepare_staging.sh, i.e. downloading the real 94 GB validation
#              set for a scored Tier 1 run.
# Not needed : every local smoke test (synthetic data instead).
#
# Note: the released VarNet checkpoint is NOT gated. It comes from
# dl.fbaipublicfiles.com and needs no credential -- prepare_staging.sh and
# verify_varnet.py --download_state_dict both fetch it directly.
FASTMRI_VAL_URL=''
FASTMRI_SHA_URL=''


# --- CHTC -------------------------------------------------------------------
# Not a secret. Your UW-Madison NetID, used to build the /staging paths.
# prepare_staging.sh defaults to $USER on the access point if this is blank,
# and shards the path by the netid's first letter, so apryan3 gives
# /staging/a/apryan3/fastmri -- which is where the dataset lives. The group
# directory /staging/groups/kamilov_group/Kamilov-SciAI-datasets is not
# readable by this account as of 2026-09-10.
#
# STAGING_DIR (not set here) overrides the whole path: point it at a local
# directory for an off-cluster run, or at the group directory if access is
# granted later.
NETID=''
