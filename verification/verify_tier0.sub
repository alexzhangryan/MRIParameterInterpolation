# verify_tier0.sub: Tier 0 on a CHTC GPU node. No data: the environment
# checks, the metric-identity check, and the fastMRI repo test suite inside
# the container. Submit with ./submit.sh tier0 (or `make submit-tier0`).
#
# Run this once per image tag before any Tier 1 job. A failing Tier 0 means
# the image is wrong and no Tier 1 result from it can be trusted.
# Same macro names, guards and directory layout as verify.sub / train.sub, so
# logs/tier0_<Cluster>.* and runs/tier0/<Cluster>/ sit next to the model runs.

# 2026-09-18 tag: wandb 0.26.1 (the 2026-09 tag's 0.18.7 rejects current
# 86-character W&B keys). Keep in step with verify.sub.
if ! defined image
  image = docker://genjigod/fastmri-verify:2026-09-18
endif
if ! defined model
  model = tier0
endif
if ! defined run_name
  run_name = verify-$(model)
endif

universe        = container
container_image = $(image)
executable      = run_verify.sh
arguments       = tier0 --run_name $(run_name)

transfer_input_files    = verify_varnet.py
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = output
transfer_output_remaps  = "output = runs/$(model)/$(Cluster)"

getenv          = WANDB_API_KEY, WANDB_ENTITY, WANDB_PROJECT
environment     = "WANDB_PROJECT=fastmri-varnet-verify"

if ! defined bad_nodes
  bad_nodes = "gpu4003.chtc.wisc.edu"
endif
requirements    = !stringListMember(Target.Machine, $(bad_nodes))
# request_cpus / request_memory are pre-seeded by condor_submit; see verify.sub
if ! defined cpus
  cpus = 2
endif
if ! defined mem
  mem = 8GB
endif
request_cpus    = $(cpus)
request_memory  = $(mem)
if ! defined request_disk
  request_disk = 10GB
endif
request_gpus    = 1
gpus_minimum_capability = 7.0
gpus_maximum_capability = 9.0
+WantGPULab     = true
+GPUJobLength   = "short"

max_retries     = 5
periodic_release = (HoldReasonCode == 6 || HoldReasonCode == 13) && (NumSystemHolds < 5) && ((time() - EnteredCurrentStatus) > 300)

log             = logs/$(model)_$(Cluster).log
output          = logs/$(model)_$(Cluster)_$(Process).out
error           = logs/$(model)_$(Cluster)_$(Process).err
stream_output   = True
stream_error    = True

queue 1
