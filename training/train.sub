# train.sub: HTCondor submit file for E2E VarNet training on CHTC.
# Submit from this directory via ./submit.sh (or `make submit-model1`), which
# creates the log/run directories, applies the per-model macros, and checks
# that the W&B key is exported first.
#
#   ./submit.sh model1                     4x only
#   ./submit.sh model2                     2x/4x/6x/8x, one rate drawn per sample
#   ./submit.sh model1 resume=runs/model1/123/checkpoints/last.ckpt
#   ./submit.sh model2 max_epochs=2 extra_args="--limit_train_batches 20"
#
# Edit `image` below before first use. `staging` is this account's personal
# /staging directory on ap2001 (confirmed writable 2026-09-10). If access to
# /staging/groups/kamilov_group/Kamilov-SciAI-datasets is granted later, this
# one macro is the only thing to repoint.

# --- how the defaults in this file work --------------------------------------
# Every macro below is a DEFAULT ONLY and is wrapped in `if ! defined`. That
# guard is load-bearing, not style.
#
# condor_submit parses a command-line `name=value` "as if it was placed at the
# beginning of the submit description file" (condor_submit man page). A plain
# `model = model1` line here is therefore parsed AFTER it and silently
# overwrites it. That bug shipped and cost a run: on 2026-09-13
# `make submit-model2` submitted with model=model2 accelerations="2 4 6 8" and
# HTCondor built the job ad with --run_name varnet-model1 --accelerations 4.
# It trained model 1's schedule for three hours and, because --run_name is also
# the W&B run id (train_wandb.py build_logger, resume="allow"), logged into the
# existing varnet-model1 run instead of creating its own.
#
# So: any knob meant to be overridable from the command line gets the guard.
# Verify after editing, on the access point, without submitting:
#   condor_submit -dry-run /dev/stdout train.sub model=model2 \
#       accelerations="2 4 6 8" center_fractions="0.16 0.08 0.0533 0.04" | grep Args
# `-append name=value` is NOT an alternative here: appended lines land just
# before `queue`, after the `if defined resume` test below has already run.
if ! defined staging
  staging = /staging/a/apryan3/fastmri
endif
if ! defined image
  image = docker://genjigod/fastmri-train:2026-09
endif

# --- what to train -----------------------------------------------------------
# The two lists are paired elementwise (fastmri.data.subsample.MaskFunc) and
# one pair is drawn uniformly per training sample. Defaults are model 1;
# submit.sh overrides them for model 2. center_fractions follow the fastMRI
# convention 0.32 / R (0.08 at 4x, 0.04 at 8x).
if ! defined model
  model = model1
endif
if ! defined accelerations
  accelerations = 4
endif
if ! defined center_fractions
  center_fractions = 0.08
endif
if ! defined mask_type
  mask_type = equispaced_fraction
endif
if ! defined max_epochs
  max_epochs = 50
endif
# run_name is the W&B run NAME and the W&B run ID. Two trainings that share it
# become one run in W&B; a resubmission of the same training must keep it.
# Deriving it from $(model) is what keeps model 1 and model 2 apart, so it is
# only correct as long as $(model) is.
if ! defined run_name
  run_name = varnet-$(model)
endif
if ! defined extra_args
  extra_args =
endif
arguments        = --run_name $(run_name) --accelerations $(accelerations) --center_fractions $(center_fractions) --mask_type $(mask_type) --max_epochs $(max_epochs) --gpus 1 $(extra_args)

# --- container ---------------------------------------------------------------
universe        = container
container_image = $(image)
executable      = run_train.sh

# --- input files -------------------------------------------------------------
# Large inputs live in /staging and are transferred into the job scratch by
# HTCondor, never read directly. The defaults are the subset tarballs built by
# README section 3b (subset_val.sub / subset_train.sub), which is all that
# fits under the 100 GB /staging quota. If the full splits are ever staged
# (quota increase or group-directory access), override on the command line:
#   ./submit.sh model1 train_data=file:///staging/.../knee_multicoil_train_batch_0.tar.xz request_disk=400GB
# (NYU ships the train split as five ~91 GB batches; run_train.sh extracts
# every knee_multicoil_*.tar(.xz) it is given, so several can be listed.)
# CHTC's size rule: osdf:///chtc/staging/<path> for 1-30 GB inputs,
# file:///staging/<path> from 30 GB up; file:// works for both.
if ! defined train_data
  train_data = file://$(staging)/knee_multicoil_train_subset.tar.xz
endif
if ! defined val_data
  val_data = file://$(staging)/knee_multicoil_val_subset.tar
endif
# `resume` is only defined when passed on the command line (see submit.sh).
if defined resume
  transfer_input_files = train_wandb.py, $(train_data), $(val_data), $(resume)
else
  transfer_input_files = train_wandb.py, $(train_data), $(val_data)
endif
should_transfer_files    = YES
# ON_EXIT_OR_EVICT: when the job is evicted, output/ is transferred back to
# the spool and delivered into the sandbox again when the job restarts, so
# run_train.sh finds output/checkpoints/last.ckpt and training resumes.
when_to_transfer_output  = ON_EXIT_OR_EVICT

# --- output files ------------------------------------------------------------
# output/checkpoints/{last.ckpt, epoch=*.ckpt}, output/wandb/ (offline run if
# no key), output/lightning_logs/ (TensorBoard when W&B is disabled)
transfer_output_files   = output
transfer_output_remaps  = "output = runs/$(model)/$(Cluster)"

# --- secrets -----------------------------------------------------------------
# Only these names are copied from the submitting shell, and only if set. The
# key never appears in this file or in any committed file. It does appear in
# the job ClassAd (condor_q -l), readable by you and CHTC admins only.
getenv          = WANDB_API_KEY, WANDB_ENTITY, WANDB_PROJECT
environment     = "WANDB_PROJECT=fastmri-varnet-train"

# --- resources ---------------------------------------------------------------
# request_disk covers peak scratch during extraction: run_train.sh deletes a
# tarball only after `xz | tar` finishes, so compressed + extracted coexist.
# With the section-3b subsets (65 GB train .tar.xz -> ~125 GB, 20 GB val .tar
# -> 20 GB) peak is ~210 GB. Size this from the tarballs actually staged
# (du -sh on /staging; a .tar.xz extracts to ~1.9x) and override on the
# command line: ./submit.sh model1 request_disk=600GB
#
# HasCHTCStaging selects slots that can read /staging inputs. bad_nodes is the
# escape hatch for an execute node whose GPU stack is broken in a way that is
# not our problem to fix: 2026-09-12 gpu4003 held a job with code 6 because the
# NVIDIA container hook failed to symlink libcuda.so ("bad file descriptor")
# before any of our code ran. Add or clear names here, or override for one
# submission:  ./submit.sh model1 bad_nodes='"gpu4003.chtc.wisc.edu"'
if ! defined bad_nodes
  bad_nodes = "gpu4003.chtc.wisc.edu"
endif
requirements    = (Target.HasCHTCStaging == true) && !stringListMember(Target.Machine, $(bad_nodes))
# request_cpus and request_memory are the two exceptions to the `if ! defined`
# rule: condor_submit seeds them into the macro table BEFORE reading this file
# (they carry HTCondor's own defaults), so the guard never fires and the request
# silently collapses to 1 CPU and an ImageSize-derived memory figure. Measured,
# not assumed:
#   condor_submit -dry-run /dev/stdout train.sub | grep -E 'RequestCpus|RequestMemory'
# Hence the aliases. Override these two as cpus=16 / mem=64GB, not as
# request_cpus= / request_memory=, which this file would overwrite.
# request_disk and request_gpus are NOT pre-seeded, so they take the guard and
# keep their own names. submit.sh prints all four from the dry-run ad before
# submitting, so a future HTCondor that pre-seeds one more of them shows up
# there instead of on the execute node.
#
# cpus: DataLoader workers (--num_workers, default 4) plus the main process.
if ! defined cpus
  cpus = 8
endif
if ! defined mem
  mem = 48GB
endif
request_cpus    = $(cpus)
request_memory  = $(mem)
if ! defined request_disk
  request_disk = 260GB
endif
if ! defined request_gpus
  request_gpus = 1
endif
gpus_minimum_memory     = 24000M
gpus_minimum_capability = 7.0
# Upper bound matters: this image's PyTorch ships kernels for sm_37..sm_90.
# An sm_120 (Blackwell, Capability 12.0) slot matches happily and then dies
# with "no kernel image is available for execution on the device" as soon as
# the first kernel launches. Raise this only with a PyTorch built for it.
gpus_maximum_capability = 9.0
+WantGPULab     = true
# "long" is the multi-day GPU Lab class. A 50-epoch multicoil run will still
# outlast it; see README "Resuming" for what to do when the job is removed.
+GPUJobLength   = "long"

# --- transient node failures -------------------------------------------------
# Two hold codes mean "the node, not this run" and are released automatically:
#   6  execute-node problem before anything ran (docker daemon, NVIDIA
#      container hook), e.g. gpu4003 on 2026-09-12.
#   13 input transfer failed. 2026-09-12 gpu4000 pulled the 63 GiB train
#      tarball from /staging fine, then curl_plugin gave up on the 19 GiB val
#      tarball 8 GiB in ("Aborted due to lack of progress"): a stalled
#      /staging read, nothing to do with the files, which were intact.
# In both cases the same submission on the next attempt usually just works,
# and nothing of ours has run yet, so a retry costs only the transfer time.
# Release a few times so one bad node or one NFS stall cannot end a multi-day
# run, and stop after that so a genuine repeatable failure (a missing staging
# file also holds with code 13) still surfaces as a hold instead of looping.
# NumJobStarts does not count these (nothing started), hence NumSystemHolds.
max_retries     = 5
periodic_release = (HoldReasonCode == 6 || HoldReasonCode == 13) && (NumSystemHolds < 5) && ((time() - EnteredCurrentStatus) > 300)

# --- logs ------------------------------------------------------------------
log             = logs/$(model)_$(Cluster).log
output          = logs/$(model)_$(Cluster)_$(Process).out
error           = logs/$(model)_$(Cluster)_$(Process).err
stream_output   = True
stream_error    = True

queue 1
